{
  "name": "dsh-moss-theme",
  "version": "0.1.0",
  "description": "The Wandering Earth inspired 550W console theme and live session status for DeepSeek Harness.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "licenses"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "preview:build": "tsdown --config preview/tsdown.config.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.2",
    "@types/react-dom": "^18.3.7"
  }
}
