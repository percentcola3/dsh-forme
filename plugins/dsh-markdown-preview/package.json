{
  "name": "dsh-markdown-preview",
  "version": "0.1.0",
  "description": "Readable Markdown file previews with theme-aware colors and community Mermaid diagrams for DeepSeek Harness.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "license": "MIT",
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"]
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "dsh-mermaid-preview": "git+https://github.com/realguan/dsh-mermaid-preview.git#fcbb7e3ff3c273962524a9bb5610aeb4f01c6cb3"
  },
  "peerDependencies": { "@deepseek-ai/cordis": "*" },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.2"
  }
}
