{
  "name": "dsh-version-update",
  "version": "0.1.0",
  "description": "Show DeepSeek Harness version and update npm/npx installs from the sidebar.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-runtime"]
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "test": "node --test --experimental-strip-types src/probe.test.ts tests/window-chrome.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.2"
  }
}
