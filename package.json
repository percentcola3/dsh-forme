    "dsh-quick-prompts": "github:percentcola3/dsh-forme#path:plugins/dsh-quick-prompts",
    "dsh-project-run": "github:percentcola3/dsh-forme#path:plugins/dsh-project-run",
    "dsh-version-update": "github:percentcola3/dsh-forme#path:plugins/dsh-version-update"
  }
