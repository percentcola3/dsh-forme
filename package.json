{
  "name": "dsh-forme",
  "version": "0.1.0",
  "description": "Git changes, file previews, reusable tasks, and a 550W console theme for DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "files": [
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "dsh-git-plus": "git+ssh://git@github.com/percentcola3/dsh-forme.git#path:plugins/dsh-git-plus",
    "dsh-file-preview": "git+ssh://git@github.com/percentcola3/dsh-forme.git#path:plugins/dsh-file-preview",
    "dsh-quick-prompts": "git+ssh://git@github.com/percentcola3/dsh-forme.git#path:plugins/dsh-quick-prompts",
    "dsh-moss-theme": "git+ssh://git@github.com/percentcola3/dsh-forme.git#path:plugins/dsh-moss-theme"
  },
  "scripts": {
    "install:desktop": "node scripts/install-local.mjs"
  }
}
